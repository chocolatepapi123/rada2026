# Copy to .env.local and fill in. Never commit real values.

# --- Needed for the website (set these in your host's environment settings too) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Your public web address with no trailing slash, e.g. https://rada.co.ke (used for share previews and shared links)
VITE_PUBLIC_URL=
# Optional: shown in crash reports so you know which build crashed
VITE_APP_VERSION=

# --- NEVER set this in production. Only for a staging/promo build that allows ?demo=1 ---
VITE_ENABLE_DEMO=

# --- Not needed to run the website. Only for the helper scripts in /scripts, run on your own computer ---
# Never put these in your host's website settings and never prefix them with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
APIFY_API_TOKEN=
# Only if you run the optional Node server (npm run start:server). The app itself does not call it.
GEMINI_API_KEY=
